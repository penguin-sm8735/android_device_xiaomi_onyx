From d43aa37ae1bccd9522446d5e94a1cb91c5154f4e Mon Sep 17 00:00:00 2001
From: Alex <05jeelo30@gmail.com>
Date: Mon, 26 Oct 2026 13:21:41 +0000
Subject: [PATCH] audioflinger: Do not suspend the Dolby effect matched by uuid

LunarisDolby creates the global Dolby effect with EFFECT_TYPE_NULL and
the DAP uuid, and audio_effects_config.xml declares dap_hw without
typeSameAsUuid, so isEffectEligibleForSuspend()'s type checks miss it.
Any session effect an app enables then suspends the Dolby processor
until it is turned off and on again. Match the DAP, DAP offload and
dap_hw uuids too.

Based on xiaomi-onyx-playground/luna_frameworks_av 288642b.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QY97AsgNLyAwQpzrsxC9zt
---
 services/audioflinger/Effects.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/services/audioflinger/Effects.cpp b/services/audioflinger/Effects.cpp
index b3d7795..8fc4429 100644
--- a/services/audioflinger/Effects.cpp
+++ b/services/audioflinger/Effects.cpp
@@ -2978,6 +2978,11 @@ static const effect_uuid_t SL_IID_DAP_ = { 0x46d279d9, 0x9be7, 0x453d, 0x9d7c,
                                          { 0xef, 0x93, 0x7f, 0x67, 0x55, 0x87 } };
 const effect_uuid_t * const SL_IID_DAP = &SL_IID_DAP_;
 
+// Dolby DAP hardware effect (dap_hw in audio_effects_config.xml)
+static const effect_uuid_t SL_IID_DAP_HW_ = { 0x9d4921da, 0x8225, 0x4f29, 0xaefa,
+                                            { 0x39, 0x53, 0x7a, 0x04, 0xbc, 0xaa } };
+const effect_uuid_t * const SL_IID_DAP_HW = &SL_IID_DAP_HW_;
+
 /* static */
 bool EffectChain::isEffectEligibleForBtNrecSuspend_l(const effect_uuid_t* type) {
     // Only NS and AEC are suspended when BtNRec is off
@@ -2998,6 +3003,11 @@ bool EffectChain::isEffectEligibleForSuspend(const effect_descriptor_t& desc)
           (memcmp(&desc.type, SL_IID_VISUALIZATION, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_VOLUME, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_DAP, sizeof(effect_uuid_t)) == 0) ||
+          // LunarisDolby creates the global Dolby effect with EFFECT_TYPE_NULL and the DAP
+          // uuid, and audio_effects_config.xml declares dap_hw without typeSameAsUuid, so
+          // the type checks above miss it and any session effect would suspend Dolby.
+          (memcmp(&desc.uuid, SL_IID_DAP, sizeof(effect_uuid_t)) == 0) ||
+          (memcmp(&desc.uuid, SL_IID_DAP_HW, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_DYNAMICSPROCESSING, sizeof(effect_uuid_t)) == 0)))) {
         return false;
     }
